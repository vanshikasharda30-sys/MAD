<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.ClinicAI.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/doctorInitials"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:background="@drawable/bg_avatar"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/teal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/doctorName"
                style="@style/TextAppearance.ClinicAI.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/doctorSubtitle"
                style="@style/TextAppearance.ClinicAI.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/doctorClinic"
                style="@style/TextAppearance.ClinicAI.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_50"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/doctorMeta"
                style="@style/TextAppearance.ClinicAI.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/doctorDistance"
                style="@style/TextAppearance.ClinicAI.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/teal"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/ink_50" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
