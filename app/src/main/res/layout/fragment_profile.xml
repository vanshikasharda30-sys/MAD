<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/TextAppearance.ClinicAI.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_title" />

        <!-- Signed out -->
        <LinearLayout
            android:id="@+id/signedOutGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/TextAppearance.ClinicAI.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_signed_out_title" />

            <TextView
                style="@style/TextAppearance.ClinicAI.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_signed_out_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signInButton"
                style="@style/Widget.ClinicAI.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/action_sign_in" />
        </LinearLayout>

        <!-- Signed in -->
        <LinearLayout
            android:id="@+id/signedInGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClinicAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/accountName"
                        style="@style/TextAppearance.ClinicAI.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/accountEmail"
                        style="@style/TextAppearance.ClinicAI.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/roleChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_pill_teal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/teal"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/profileProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/teal" />

                    <TextView
                        android:id="@+id/profileError"
                        style="@style/TextAppearance.ClinicAI.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/red"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appointmentsButton"
                style="@style/Widget.ClinicAI.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_my_appointments"
                app:icon="@drawable/ic_event" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/staffButton"
                style="@style/Widget.ClinicAI.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/teal"
                android:text="@string/home_staff_dashboard"
                android:visibility="gone"
                app:icon="@drawable/ic_group" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signOutButton"
                style="@style/Widget.ClinicAI.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_sign_out"
                android:textColor="@color/red"
                app:icon="@drawable/ic_logout"
                app:iconTint="@color/red" />
        </LinearLayout>

        <!-- About -->
        <TextView
            style="@style/TextAppearance.ClinicAI.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/profile_about" />

        <TextView
            style="@style/TextAppearance.ClinicAI.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/profile_about_body" />

        <TextView
            android:id="@+id/versionText"
            style="@style/TextAppearance.ClinicAI.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
